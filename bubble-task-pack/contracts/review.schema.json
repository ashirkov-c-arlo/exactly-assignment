{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exactly.ai/contracts/bubble-review.schema.json",
  "title": "Bubble illustration review",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "asset_id",
    "processing_status",
    "verdict",
    "summary",
    "issues",
    "unverifiable_checks",
    "blocking_reason"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "processing_status": {
      "enum": ["completed", "input_error", "provider_error"]
    },
    "verdict": {
      "enum": ["ship", "reject", "human_review", "unsupported", null]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "unverifiable_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unverifiableCheck"
      }
    },
    "blocking_reason": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "processing_status": {
            "const": "completed"
          }
        },
        "required": ["processing_status"]
      },
      "then": {
        "properties": {
          "verdict": {
            "enum": ["ship", "reject", "human_review", "unsupported"]
          }
        }
      },
      "else": {
        "properties": {
          "verdict": {
            "const": null
          },
          "blocking_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "severity",
        "observation",
        "source_ids",
        "why_it_matters",
        "suggested_fix"
      ],
      "properties": {
        "severity": {
          "enum": ["critical", "major", "minor"]
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "suggested_fix": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unverifiableCheck": {
      "type": "object",
      "additionalProperties": true,
      "required": ["check_id", "reason"],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
